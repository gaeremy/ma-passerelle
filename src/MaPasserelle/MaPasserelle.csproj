<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Platforms>x64;ARM64</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MaPasserelle</RootNamespace>
    <AssemblyName>mapasserelle</AssemblyName>
    <ApplicationIcon>..\..\assets\icon\ma-passerelle.ico</ApplicationIcon>
    <!-- Autonome : .NET est embarqué, rien à installer sur le PC. Pas d'élagage (trimming) :
         l'interop COM/WinRT de la capture ne le supporte pas. -->
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' != 'ARM64'">win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\vendor\WinPlay\src\WinPlay.Core\WinPlay.Core.csproj" />
    <ProjectReference Include="..\MaPasserelle.Capture\MaPasserelle.Capture.csproj" />
    <ProjectReference Include="..\MaPasserelle.Engine\MaPasserelle.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
