<Project Sdk="Microsoft.NET.Sdk">

  <!-- Le moteur de Ma Passerelle : appareils, jumelages, partage. Utilisé par la ligne de
       commande (mapasserelle.exe) et par l'application de la barre des tâches. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MaPasserelle.Engine</RootNamespace>
    <Platforms>x64;ARM64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\vendor\WinPlay\src\WinPlay.Core\WinPlay.Core.csproj" />
    <ProjectReference Include="..\MaPasserelle.Capture\MaPasserelle.Capture.csproj" />
  </ItemGroup>

</Project>
