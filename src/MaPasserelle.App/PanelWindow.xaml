<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MaPasserelle.App.PanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Ma Passerelle">

    <Grid x:Name="Root">

        <!-- ============================================================ vue principale -->
        <Grid x:Name="MainView" Padding="20,18,20,14" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- En-tête : icône, nom, état, réglages, fermer. -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="ms-appx:///Assets/ma-passerelle-64.png" Width="36" Height="36" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Ma Passerelle" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="StateText" Text="Prêt" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="2" Click="OnOpenSettings" Background="Transparent" BorderThickness="0" Padding="8"
                        VerticalAlignment="Top" ToolTipService.ToolTip="Réglages" AutomationProperties.Name="Réglages">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                </Button>
                <Button Grid.Column="3" Click="OnHide" Background="Transparent" BorderThickness="0" Padding="8"
                        VerticalAlignment="Top" ToolTipService.ToolTip="Fermer le panneau" AutomationProperties.Name="Fermer le panneau">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </Grid>

            <!-- Où projeter. -->
            <StackPanel Grid.Row="1" Spacing="6">
                <TextBlock Text="Projeter sur" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="DeviceBox" HorizontalAlignment="Stretch" PlaceholderText="Recherche des appareils…"
                              DisplayMemberPath="Label" SelectionChanged="OnDeviceChanged" AutomationProperties.Name="Projeter sur" />
                    <Button x:Name="SearchButton" Grid.Column="1" Click="OnSearch" ToolTipService.ToolTip="Chercher à nouveau"
                            AutomationProperties.Name="Chercher à nouveau">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                </Grid>
                <HyperlinkButton x:Name="ShowAddressButton" Content="Se connecter par adresse IP" Padding="0,2" Click="OnShowAddress" />
                <Grid x:Name="AddressPanel" Visibility="Collapsed" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="AddressBox" PlaceholderText="Exemple : 192.168.1.20" KeyDown="OnAddressKey"
                             AutomationProperties.Name="Adresse IP de l'appareil" />
                    <Button Grid.Column="1" Content="Ajouter" Click="OnAddAddress" />
                </Grid>

                <!-- Jumelage : une seule fois par appareil. -->
                <Border x:Name="PairPanel" Visibility="Collapsed" Padding="12" CornerRadius="6"
                        Background="{ThemeResource PasserelleSoftBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="PairText" TextWrapping="Wrap" />
                        <Button x:Name="PairButton" Content="Jumeler" Click="OnPair" />
                        <Grid x:Name="PinPanel" Visibility="Collapsed" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PinBox" PlaceholderText="Code affiché sur l'appareil" MaxLength="8"
                                     InputScope="Number" KeyDown="OnPinKey" AutomationProperties.Name="Code de jumelage" />
                            <Button Grid.Column="1" Content="Valider" Style="{StaticResource AccentButtonStyle}" Click="OnPinConfirm" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Quoi partager. -->
            <Grid Grid.Row="2">
                <TextBlock Text="Partager" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right">
                    <RadioButton x:Name="ScreenChoice" Content="Un écran" GroupName="Kind" IsChecked="True" Checked="OnKindChanged" MinWidth="0" />
                    <RadioButton x:Name="WindowChoice" Content="Une fenêtre" GroupName="Kind" Checked="OnKindChanged" MinWidth="0" />
                </StackPanel>
            </Grid>

            <!-- Miniatures des écrans ou des fenêtres. -->
            <GridView x:Name="SourceGrid" Grid.Row="3" Margin="-4,0" SelectionMode="Single"
                      AutomationProperties.Name="Écran ou fenêtre à partager">
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="170" Padding="2,2,2,4" Spacing="4">
                            <Grid Height="96" CornerRadius="4" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                <FontIcon Glyph="{Binding Glyph}" FontSize="26" Visibility="{Binding PlaceholderVisibility}"
                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </Grid>
                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <!-- Action principale. -->
            <StackPanel Grid.Row="4" Spacing="8">
                <InfoBar x:Name="Message" IsClosable="True" IsOpen="False" />
                <Button x:Name="ShareButton" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch"
                        Padding="12,10" Click="OnShare" IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="ShareIcon" Glyph="&#xEC15;" FontSize="16" />
                        <TextBlock x:Name="ShareText" Text="Partager" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Pied : version et sortie. -->
            <Grid Grid.Row="5">
                <TextBlock x:Name="VersionText" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <HyperlinkButton HorizontalAlignment="Right" Content="Quitter Ma Passerelle" Padding="4,2" Click="OnQuit" />
            </Grid>
        </Grid>

        <!-- ============================================================ réglages -->
        <Grid x:Name="SettingsView" Visibility="Collapsed" Padding="20,18,20,14" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="OnCloseSettings" Background="Transparent" BorderThickness="0" Padding="8"
                        ToolTipService.ToolTip="Retour" AutomationProperties.Name="Retour">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <TextBlock Text="Réglages" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" Margin="-20,0" Padding="20,0">
                <StackPanel Spacing="22" Padding="0,0,0,8">

                    <StackPanel Spacing="6">
                        <TextBlock Text="Qualité de l'image" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <RadioButton x:Name="Quality720" GroupName="Quality" Tag="720" Checked="OnQualityChecked"
                                     AutomationProperties.Name="Économe, 720p">
                            <StackPanel>
                                <TextBlock Text="Économe (720p)" />
                                <TextBlock Text="Pour un Wi-Fi chargé ou lent. Le texte est un peu moins net, l'image reste fluide."
                                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="Quality1080" GroupName="Quality" Tag="1080" Checked="OnQualityChecked"
                                     AutomationProperties.Name="Standard, Full HD 1080p, recommandé">
                            <StackPanel>
                                <TextBlock Text="Standard (Full HD 1080p), recommandé" />
                                <TextBlock Text="Net pour les documents et les présentations, adapté à la plupart des réseaux."
                                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="Quality2160" GroupName="Quality" Tag="2160" Checked="OnQualityChecked"
                                     AutomationProperties.Name="Très haute définition, 4K">
                            <StackPanel>
                                <TextBlock Text="Très haute définition (4K)" />
                                <TextBlock Text="Seulement si l'écran partagé et l'appareil sont en 4K, avec un réseau rapide et stable."
                                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </RadioButton>
                        <TextBlock Text="Une image plus petite n'est jamais agrandie : un écran Full HD reste en Full HD."
                                   Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Fluidité" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <RadioButton x:Name="Fps30" GroupName="Fps" Tag="30" Checked="OnFpsChecked"
                                     AutomationProperties.Name="Normale, 30 images par seconde, recommandé">
                            <StackPanel>
                                <TextBlock Text="Normale (30 images par seconde), recommandé" />
                                <TextBlock Text="Documents, diapositives, pages web. Ménage le PC et le réseau."
                                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="Fps60" GroupName="Fps" Tag="60" Checked="OnFpsChecked"
                                     AutomationProperties.Name="Élevée, 60 images par seconde">
                            <StackPanel>
                                <TextBlock Text="Élevée (60 images par seconde)" />
                                <TextBlock Text="Vidéos, animations, jeux. Demande davantage au PC et au réseau."
                                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <StackPanel Spacing="14">
                        <TextBlock Text="Options" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Son du PC" />
                                <TextBlock Text="Le son sort de l'appareil de projection au lieu du PC."
                                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="AudioSwitch" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"
                                          Toggled="OnSwitchToggled" AutomationProperties.Name="Son du PC" />
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Pointeur de la souris" />
                                <TextBlock Text="Le pointeur apparaît dans l'image partagée."
                                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="CursorSwitch" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"
                                          Toggled="OnSwitchToggled" AutomationProperties.Name="Pointeur de la souris" />
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Démarrer avec Windows" />
                                <TextBlock Text="Ma Passerelle attend discrètement près de l'horloge, prête à partager."
                                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="StartupHint" Visibility="Collapsed" Margin="0,4,0,0"
                                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="StartupSwitch" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"
                                          Toggled="OnStartupToggled" AutomationProperties.Name="Démarrer avec Windows" />
                        </Grid>
                    </StackPanel>

                    <TextBlock Text="Les réglages d'image et de son s'appliquent au prochain partage."
                               Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                    <!-- Mention légale demandée par la GPL v3 (section 0, « Appropriate Legal Notices »). -->
                    <StackPanel Spacing="4" Margin="0,6,0,12">
                        <TextBlock Text="À propos" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Logiciel libre sous licence GNU GPL version 3 ou ultérieure, fourni sans aucune garantie. Basé sur WinPlay de Dinesh Dhotrad et doubletake." />
                        <HyperlinkButton Content="Code source, licence et crédits" Padding="0,2" Margin="0,2,0,0"
                                         NavigateUri="https://github.com/gaeremy/ma-passerelle" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
