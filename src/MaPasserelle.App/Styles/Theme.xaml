<?xml version="1.0" encoding="utf-8"?>
<!-- Accent corail de Mon Estrade (mêmes valeurs que son Styles/Theme.xaml). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!-- Couleurs d'accent de base : les modèles Fluent (boutons radio, liens, interrupteurs)
                 en dérivent leurs pinceaux. -->
            <Color x:Key="SystemAccentColor">#CE544C</Color>
            <Color x:Key="SystemAccentColorLight1">#D9706A</Color>
            <Color x:Key="SystemAccentColorLight2">#E48F89</Color>
            <Color x:Key="SystemAccentColorLight3">#EFB2AE</Color>
            <Color x:Key="SystemAccentColorDark1">#B8453E</Color>
            <Color x:Key="SystemAccentColorDark2">#A9453F</Color>
            <Color x:Key="SystemAccentColorDark3">#853631</Color>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#CE544C" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E5CE544C" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CCCE544C" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#A9453F" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#853631" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#CE544C" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#B3FFFFFF" />
            <SolidColorBrush x:Key="PasserelleSoftBrush" Color="#1FCE544C" />
            <!-- Bandeau « succès » : fond neutre plutôt que le vert par défaut, coche verte adoucie. -->
            <SolidColorBrush x:Key="InfoBarSuccessSeverityBackgroundBrush" Color="#0C000000" />
            <SolidColorBrush x:Key="InfoBarSuccessSeverityIconBackground" Color="#FF3A9D63" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="SystemAccentColor">#F68E87</Color>
            <Color x:Key="SystemAccentColorLight1">#F79D97</Color>
            <Color x:Key="SystemAccentColorLight2">#F68E87</Color>
            <Color x:Key="SystemAccentColorLight3">#F9B1AC</Color>
            <Color x:Key="SystemAccentColorDark1">#E0756E</Color>
            <Color x:Key="SystemAccentColorDark2">#CE544C</Color>
            <Color x:Key="SystemAccentColorDark3">#A9453F</Color>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#F68E87" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E5F68E87" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CCF68E87" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#F9B1AC" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#F9B1AC" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#F68E87" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#000000" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#B3000000" />
            <SolidColorBrush x:Key="PasserelleSoftBrush" Color="#29F68E87" />
            <SolidColorBrush x:Key="InfoBarSuccessSeverityBackgroundBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="InfoBarSuccessSeverityIconBackground" Color="#FF8BD3A5" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast" />
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
